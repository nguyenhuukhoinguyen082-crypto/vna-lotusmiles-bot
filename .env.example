# ---- Required ----
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here

# ---- Admin (only this user ID can use admin-only commands) ----
# Set to YOUR Discord user ID (right-click your profile -> Copy User ID).
# Only this single user may use /set-grading-channel and /spawn-exam-panel.
ADMIN_USER_ID=your_discord_user_id_here

# ---- Firebase ----
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ---- Role IDs ----
ROLE_STAGE_1=1500499569899999294
ROLE_PHASE_2=1500499568331198604

# ---- Channel IDs ----
CHANNEL_PHASE_1_RESULTS=1537369655834968137
CHANNEL_PHASE_2_HOSTING=1537367556656988231
CHANNEL_PHASE_2_REQUEST=1537376032737468456
CHANNEL_PHASE_2_INSTRUCTIONS=1500508813629849770
CHANNEL_PHASE_3_REQUESTS=1537378200584331285
# Fallback submission channel. NOTE: Use /set-grading-channel in-Discord to
# set this dynamically - the bot stores it in Firebase and it overrides this env var.
CHANNEL_INSTRUCTOR_QUEUE=000000000000000000
STAGE_FLIGHT_VC=1505877118746103828

# ---- Debug ----
DEBUG=true
