# ── Discord ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Role that can run staff commands (/flight-create, /flight-cancel, /miles-adjust)
STAFF_ROLE_ID=

# ── Channels ─────────────────────────────────────────────────────────────
# Where collected exit-survey feedback gets forwarded as an embed (#exit-feedback)
EXIT_FEEDBACK_CHANNEL_ID=

# Where "failed to DM" notices get logged. Fill this in once you have the
# channel ID — can be the same staff channel Dyno posts leave alerts to, or
# a separate one, your call.
EXIT_SURVEY_LOG_CHANNEL_ID=

# ── Firebase (Admin SDK service account) ────────────────────────────────
# See references/firebase-setup.md in the bot-builder skill for how to get these.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
